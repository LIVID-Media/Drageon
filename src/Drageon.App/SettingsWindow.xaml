<Window x:Class="Drageon.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Drageon.App.Views"
        xmlns:local="clr-namespace:Drageon.App"
        Title="{local:Loc Key=settings.title}" Width="760" Height="500" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <Border Background="{StaticResource BackgroundBrush}" Padding="28">
        <views:SettingsView />
    </Border>
</Window>
