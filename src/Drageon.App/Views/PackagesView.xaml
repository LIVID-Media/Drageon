<UserControl x:Class="Drageon.App.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Drageon.App">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{local:Loc Key=packages.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{local:Loc Key=packages.subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="&#xE710;" ToolTip="{local:Loc Key=common.new}" Command="{Binding NewManifestCommand}" Style="{StaticResource IconButton}" Margin="0,0,8,0" />
                <Button Content="&#xE72C;" ToolTip="{local:Loc Key=common.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" />
            </StackPanel>
        </Grid>
        <ListBox Grid.Row="1" ItemsSource="{Binding GroupedComponents}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" Margin="2,10,0,10" /></DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StateText}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="&#xE74D;" ToolTip="{local:Loc Key=packages.deleteComponent}"
                                        Command="{Binding DataContext.DeleteComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding CanDeleteComponent}"
                                        Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="14,0,0,0" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="&#xE70F;" ToolTip="{local:Loc Key=packages.editManifest}"
                                        Command="{Binding DataContext.EditManifestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Style="{StaticResource IconButton}" VerticalAlignment="Top" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}"
                                          DisplayMemberPath="DisplayText" VerticalAlignment="Top" Style="{StaticResource CompactComboBox}" />
                                <Button Grid.Column="4" Content="&#xE71B;" ToolTip="{local:Loc Key=packages.openDownloadPage}"
                                        Command="{Binding DataContext.OpenDownloadPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Visibility="{Binding CanOpenDownloadPage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource IconButton}" VerticalAlignment="Top" />
                                <WrapPanel Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,0,0,0">
                                    <Button Content="&#xE713;" ToolTip="{local:Loc Key=packages.configure}"
                                            Command="{Binding DataContext.ConfigureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanConfigure, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource IconButton}" Margin="0,0,8,8" />
                                    <Button Content="&#xE74D;" ToolTip="{local:Loc Key=packages.deleteVersion}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}" Style="{StaticResource IconButton}" Margin="0,0,8,8" />
                                    <Button Content="{Binding VersionActionGlyph}" ToolTip="{Binding VersionActionText}"
                                            Visibility="{Binding ShowVersionAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.VersionActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding CanUseVersionAction}" Style="{StaticResource PrimaryIconButton}" Margin="0,0,8,8" />
                                    <Button Content="{Binding StartStopGlyph}" ToolTip="{Binding StartStopText}"
                                            Command="{Binding DataContext.StartStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding ShowStartStop, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource PrimaryIconButton}" Margin="0,0,8,8" />
                                    <Button Content="&#xE8A7;" ToolTip="{local:Loc Key=common.open}"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding CanOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Style="{StaticResource PrimaryIconButton}" Margin="0,0,0,8" />
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" Margin="0,14,0,0" />
    </Grid>
</UserControl>
