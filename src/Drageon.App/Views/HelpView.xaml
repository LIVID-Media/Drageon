<UserControl x:Class="Drageon.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Drageon.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="{Binding QuickTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding QuickText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding QuickHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding ComponentsTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding ComponentsText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ComponentsHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding VHostsTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding VHostsText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding VHostsHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding VHostsApacheExample, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="165" Style="{StaticResource CodeEditorTextBox}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            <TextBox Grid.Column="2" Text="{Binding VHostsNginxExample, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="165" Style="{StaticResource CodeEditorTextBox}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Grid>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding PhpTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding PhpText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PhpHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding ServerTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding ServerText}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ServerHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding CronTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding CronText}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding CronExample, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="235" Style="{StaticResource CodeEditorTextBox}" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{Binding CronHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding MailTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="{Binding MailText}" TextWrapping="Wrap"/>
                        <TextBox Text="{Binding MailPhp, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="115" Style="{StaticResource CodeEditorTextBox}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding MailServer}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBox Text="{Binding MailExample, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="115" Style="{StaticResource CodeEditorTextBox}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding MailHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource Card}">
                <Expander>
                    <Expander.Header>
                        <TextBlock Text="{Binding LogsTitle}" FontSize="18" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <TextBlock Text="{Binding LogsText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
