<UserControl x:Class="Drageon.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Drageon.App">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="{local:Loc Key=backups.title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{local:Loc Key=backups.subtitle}" Style="{StaticResource PageSubtitle}"/></StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#xE72C;" ToolTip="{local:Loc Key=common.refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.28*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="18,16,18,12"><TextBlock Text="{local:Loc Key=backups.databases}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{local:Loc Key=backups.databasesHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1">
                        <ListBox ItemsSource="{Binding Databases}" Style="{StaticResource TransparentListBox}" Background="Transparent">
                            <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="2,0"><TextBlock Text="{Binding Name}"/></CheckBox></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,16">
                        <Button Content="&#xE74E;" ToolTip="{local:Loc Key=backups.selected}" Command="{Binding BackupSelectedCommand}" Style="{StaticResource IconButton}" Margin="0,0,8,0"/>
                        <Button Content="&#xEA35;" ToolTip="{local:Loc Key=backups.all}" Command="{Binding BackupAllCommand}" Style="{StaticResource IconButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="18,16,18,12">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{local:Loc Key=backups.existing}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{local:Loc Key=backups.restoreHint}" Style="{StaticResource MutedText}" Margin="0,4,12,0" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="{local:Loc Key=backups.target}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Databases}" SelectedValuePath="Name" SelectedValue="{Binding TargetDatabase}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1" MinHeight="220">
                        <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" Style="{StaticResource TransparentListBox}" Background="Transparent">
                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DatabaseName}" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding CreatedAtLabel}" HorizontalAlignment="Right"/><TextBlock Text="{Binding SizeLabel}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,12,18,16" Visibility="{Binding BackupActionsVisibility}">
                        <Button Content="&#xEE71;" ToolTip="{local:Loc Key=backups.restore}" Command="{Binding RestoreCommand}" Style="{StaticResource IconButton}" Margin="0,0,8,0"/>
                        <Button Content="&#xE74D;" ToolTip="{local:Loc Key=action.delete}" Command="{Binding DeleteBackupCommand}" Style="{StaticResource IconButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#xE838;" ToolTip="{local:Loc Key=backups.openFolder}" Command="{Binding OpenBackupFolderCommand}" Style="{StaticResource FooterIconButton}"/>
        </Grid>
    </Grid>
</UserControl>
