<UserControl x:Class="Drageon.App.Views.ApacheSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Drageon.App">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="{local:Loc Key=apache.title}" Style="{StaticResource PageTitle}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <TextBlock Text="{local:Loc Key=apache.subtitle}" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource AccentSecondaryBrush}" Margin="8,0,0,0" FontWeight="SemiBold" />
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.ColumnSpan="3"><TextBlock Text="{local:Loc Key=apache.serverName}" Margin="0,0,0,5" /><TextBox Text="{Binding ServerName}" IsReadOnly="True" Foreground="{StaticResource MutedTextBrush}" Style="{StaticResource CompactTextBox}" /><TextBlock Text="{local:Loc Key=apache.serverNameHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="{local:Loc Key=apache.threads}" Margin="0,0,0,5" /><TextBox Text="{Binding ThreadsPerChild, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBox}" /><TextBlock Text="{local:Loc Key=apache.threadsHint}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0"><TextBlock Text="{local:Loc Key=apache.logLevel}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" Style="{StaticResource CompactComboBox}" /></StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                        <CheckBox Content="{local:Loc Key=apache.htaccess}" IsChecked="{Binding AllowHtaccess}" />
                        <CheckBox Content="{local:Loc Key=apache.directoryListing}" IsChecked="{Binding DirectoryListing}" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Text="{local:Loc Key=apache.custom}" Margin="0,18,0,6" />
            <TextBox Text="{Binding CustomConfiguration, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="180"
                     VerticalScrollBarVisibility="Auto" Style="{StaticResource CodeEditorTextBox}" />
            <Grid Margin="0,16,0,0">
                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,330,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#xE74E;" ToolTip="{local:Loc Key=common.saveOnly}" Command="{Binding SaveCommand}" Style="{StaticResource FooterIconButton}" Margin="0,0,8,0" />
                    <Button ToolTip="{local:Loc Key=common.saveRestart}" Command="{Binding SaveAndRestartCommand}" Style="{StaticResource PrimaryFooterIconButton}" Width="58">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons"/><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" Margin="6,0,0,0"/></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
