<Window x:Class="Drageon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Drageon.App.ViewModels"
        xmlns:views="clr-namespace:Drageon.App.Views"
        xmlns:local="clr-namespace:Drageon.App"
        Title="{x:Static local:AppInfo.AppName}" Icon="/Assets/Brand/drageon.ico"
        Width="1180" Height="800" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PackagesViewModel}"><views:PackagesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}"><views:ProjectsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupsViewModel}"><views:BackupsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:VHostsViewModel}"><views:VHostsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CronJobsViewModel}"><views:CronJobsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MailViewModel}"><views:MailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}"><views:HelpView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupportViewModel}"><views:SupportView /></DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Sidebar}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="5,0,0,15">
                    <Image Width="220" Height="78" HorizontalAlignment="Left" Stretch="Uniform" SnapsToDevicePixels="True">
                        <Image.Source>
                            <BitmapImage UriSource="/Assets/Brand/drageon-logo.png" DecodePixelWidth="220" CacheOption="OnLoad" />
                        </Image.Source>
                    </Image>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ItemsControl ItemsSource="{Binding Navigation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" Style="{StaticResource NavigationButton}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Border Style="{StaticResource NavigationIndicator}" />
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource NavigationGlyph}" />
                                        <TextBlock Text="{Binding Title}" FontWeight="Normal" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,12,0,0">
                        <Button Command="{Binding ExitCommand}" Style="{StaticResource NavigationButton}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="&#xE7E8;" Style="{StaticResource NavigationGlyph}" Margin="11,2,6,0" />
                                <TextBlock Text="{local:Loc Key=app.exit}" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                            <Run Text="{local:Loc Key=app.subtitle}" /><Run Text=" · " /><Run Text="{x:Static local:AppInfo.Version}" />
                        </TextBlock>
                        <TextBlock Text="{x:Static local:AppInfo.Copyright}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
                            <Hyperlink Command="{Binding OpenAboutCommand}"><Run Text="{local:Loc Key=about.footer}" /></Hyperlink>
                            <Run Text=" · " />
                            <Hyperlink Command="{Binding OpenSupportCommand}"><Run Text="{local:Loc Key=about.support}" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
            <ContentControl Content="{Binding CurrentPage}" Margin="28,20" />
        </Border>
    </Grid>
</Window>
