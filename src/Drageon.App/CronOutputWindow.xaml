<Window x:Class="Drageon.App.CronOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Width="900" Height="650" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
        <TextBox Grid.Row="1" Text="{Binding Content, Mode=OneWay}" IsReadOnly="True"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Style="{StaticResource CodeEditorTextBox}"/>
    </Grid>
</Window>
