<Window x:Class="Drageon.App.DatabaseSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Drageon.App"
        Title="{Binding Title}" Width="760" Height="720" MinWidth="650" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource AppWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding VersionLabel}" Style="{StaticResource PageSubtitle}"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
                <TextBlock Text="{local:Loc Key=database.settings.credentials}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
                <TextBlock Text="{local:Loc Key=database.settings.user}" Margin="0,0,0,5"/><TextBox Text="{Binding DatabaseUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CompactTextBox}" Margin="0,0,0,12"/>
                <TextBlock Text="{local:Loc Key=database.settings.password}" Margin="0,0,0,5"/><PasswordBox PasswordChanged="OnPasswordChanged"/>
                <TextBlock Text="{Binding StoredPasswordStatus}" Style="{StaticResource MutedText}" Margin="0,7,0,4"/>
                <CheckBox Content="{local:Loc Key=database.settings.clearPassword}" IsChecked="{Binding ClearStoredPassword}"/>
                <TextBlock Text="{local:Loc Key=database.settings.encryptionHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{local:Loc Key=database.settings.port}" Margin="0,10,15,14"/><TextBox Grid.Column="1" Text="{Binding Port}" Style="{StaticResource CompactTextBox}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Text="{local:Loc Key=database.settings.charset}" Margin="0,10,15,14"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CharacterSet}" Style="{StaticResource CompactTextBox}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Text="{local:Loc Key=database.settings.maxConnections}" Margin="0,10,15,14"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxConnections}" Style="{StaticResource CompactTextBox}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="3" Text="{local:Loc Key=database.settings.bufferPool}" Margin="0,10,15,14"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding BufferPoolSize}" Style="{StaticResource CompactTextBox}" Margin="0,0,0,10"/>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="2"><TextBlock Text="{local:Loc Key=database.settings.custom}" Margin="0,4,0,5"/><TextBox Text="{Binding CustomConfiguration}" AcceptsReturn="True" MinHeight="110" Style="{StaticResource CodeEditorTextBox}"/></StackPanel>
            </Grid></Border>
        </StackPanel></ScrollViewer>
        <Grid Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,60,0"/><Button Content="&#xE74E;" ToolTip="{local:Loc Key=common.save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryFooterIconButton}" HorizontalAlignment="Right"/></Grid>
    </Grid>
</Window>
